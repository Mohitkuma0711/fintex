APP_ENV=development
APP_NAME=FinTax AI API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://fintax:fintax@localhost:5432/fintax
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fintax-private
STORAGE_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=10485760
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TAX_RULES_FILE=
LOG_LEVEL=INFO
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_ATTEMPTS=3
EXTRACTION_MAX_PDF_PAGES=50
VALIDATION_LOW_CONFIDENCE_THRESHOLD=0.8
KNOWLEDGE_BASE_DIR=app/knowledge_base/official
RAG_INDEX_DIR=app/knowledge_base/.index
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
CHAT_MAX_TOOL_CALLS=6
